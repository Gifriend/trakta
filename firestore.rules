rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function todayKey() {
      let wib = request.time + duration.value(7, 'h');
      return string(wib.year() * 10000 + wib.month() * 100 + wib.day());
    }
    function insideOffice(location) {
      // Approximate local distance in metres. Keep photo-location.ts in sync.
      let north = (location.latitude - (-6.2517753)) * 110600;
      let east = (location.longitude - 106.8422473) * 110660;
      return north * north + east * east <= 150 * 150;
    }
    function validLocation(location, mode) {
      return location is map
        && location.keys().hasAll(['latitude', 'longitude', 'accuracy', 'source'])
        && location.keys().hasOnly(['latitude', 'longitude', 'accuracy', 'source'])
        && location.latitude is number && location.latitude >= -90 && location.latitude <= 90
        && location.longitude is number && location.longitude >= -180 && location.longitude <= 180
        && location.accuracy is number && location.accuracy >= 0 && location.accuracy <= 40075000
        && location.source in ['camera', 'gallery']
        && (mode != 'office' || (location.source == 'camera' && location.accuracy <= 100 && insideOffice(location)));
    }
    function validEvent(event) {
      return event is map
        && event.keys().hasAll(['timestamp', 'mode', 'note', 'photoLocation'])
        && event.keys().hasOnly(['timestamp', 'mode', 'note', 'photoLocation'])
        && event.timestamp == request.time
        && event.mode in ['office', 'remote', 'field']
        && validLocation(event.photoLocation, event.mode)
        && event.note is string && event.note.size() <= 300;
    }
    function photoCommitted(uid, day, kind) {
      let photo = getAfter(/databases/$(database)/documents/users/$(uid)/attendance/$(day)/photos/$(kind)).data;
      return photo.createdAt == request.time;
    }
    match /users/{uid}/attendance/{day} {
      allow read: if owner(uid);
      allow create: if owner(uid) && day == todayKey()
        && request.resource.data.keys().hasAll(['dateKey', 'checkIn'])
        && request.resource.data.keys().hasOnly(['dateKey', 'checkIn'])
        && request.resource.data.dateKey == day
        && validEvent(request.resource.data.checkIn)
        && photoCommitted(uid, day, 'checkIn');
      allow update: if owner(uid) && day == todayKey()
        && !('checkOut' in resource.data)
        && request.resource.data.keys().hasAll(['dateKey', 'checkIn', 'checkOut'])
        && request.resource.data.keys().hasOnly(['dateKey', 'checkIn', 'checkOut'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkOut'])
        && validEvent(request.resource.data.checkOut)
        && request.resource.data.checkOut.timestamp >= resource.data.checkIn.timestamp
        && photoCommitted(uid, day, 'checkOut');
      allow delete: if false;
      match /photos/{kind} {
        function validPhoto() {
          let photo = request.resource.data;
          let padding = photo.base64.matches('.*==$') ? 2 : (photo.base64.matches('.*=$') ? 1 : 0);
          let decodedBytes = photo.base64.size() / 4 * 3 - padding;
          return photo.keys().hasAll(['base64', 'bytes', 'mimeType', 'createdAt'])
            && photo.keys().hasOnly(['base64', 'bytes', 'mimeType', 'createdAt'])
            && photo.base64 is string
            && photo.base64.size() > 0 && photo.base64.size() <= 133336
            && photo.base64.matches('^([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$')
            && photo.bytes is int && photo.bytes == decodedBytes
            && photo.bytes > 0 && photo.bytes <= 100000
            && photo.mimeType == 'image/jpeg'
            && photo.createdAt == request.time;
        }
        allow read: if owner(uid);
        allow create: if owner(uid) && day == todayKey()
          && kind in ['checkIn', 'checkOut']
          && validPhoto()
          && getAfter(/databases/$(database)/documents/users/$(uid)/attendance/$(day)).data[kind].timestamp == request.time;
        allow update, delete: if false;
      }
    }
  }
}
