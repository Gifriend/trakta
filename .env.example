# Firebase Console > Project settings > Your apps > Web app.
# These public web identifiers are embedded in the browser build.
# Never put a service account/private key here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local development ONLY. No real Firebase project is needed for emulator mode.
VITE_FIREBASE_USE_EMULATORS=false
