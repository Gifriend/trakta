{
	"name": "trakta",
	"version": "0.0.1",
	"private": true,
	"packageManager": "bun@1.4.2",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project src/service-worker/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "bun run test:unit --run",
		"firebase:login": "firebase login",
		"firestore:deploy": "firebase deploy --only firestore",
		"firebase:deploy": "bun run firestore:deploy",
		"firebase:databases": "firebase firestore:databases:list",
		"test:browser": "node scripts/browser-smoke.mjs",
		"test:pwa": "node scripts/pwa-smoke.mjs",
		"validate:svelte": "node scripts/validate-svelte.mjs",
		"emulators": "firebase emulators:start --only auth,firestore --project demo-presensi",
		"test:rules": "firebase emulators:exec --only firestore --project demo-presensi \"node --test tests/firestore.rules.test.mjs\""
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@firebase/rules-unit-testing": "^5.0.2",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/mcp": "^0.1.30",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"firebase-tools": "^14.27.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"firebase": "^12.19.0"
	}
}
